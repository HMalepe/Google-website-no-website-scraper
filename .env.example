# Copy to .env on your server and fill in values
ACCESS_PASSWORD=change-me-to-a-strong-password
SITE_NAME=Selantra WebScrape
PUBLIC_URL=https://webscrape.selantra.co.za

# Registration-date search (leads are sorted newest company first)
# ENRICH_MAX=100          # max leads to search per job
# ENRICH_DELAY_MS=1500    # pause between web searches
# ENRICH_TIMEOUT_MS=10000 # per-search timeout

# Website audit (flags broken/outdated sites as a second lead list)
# AUDIT_MAX=50            # max existing websites to audit per job
# AUDIT_TIMEOUT_MS=10000  # per-site timeout
# PAGESPEED_API_KEY=      # optional: free Google PageSpeed Insights key for mobile speed scores
